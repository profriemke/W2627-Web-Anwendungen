<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Neuer Post</title>
</head>

<body>
    <form action="/admin/posts/created" method="post">
        {{ csrfField() }}
        <input type="text" name="title" placeholder="Titel"><br>
        <input type="text" name="teaser" placeholder="Teaser"><br>
       <textarea name="text"></textarea><br>
        <input type="text" name="author"><br>
        <input type="submit">
    </form>
</body>

</html>