<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>OMM Blog</h1>
    <a href="/admin/posts/create">neuer Post</a>
    @each(post in posts)
    <h2>{{ post.title }}</h2>
    <i>{{ post.teaser }} <a href="/posts/{{ post.id }}">mehr...</a></i>
    @end
</body>
</html>