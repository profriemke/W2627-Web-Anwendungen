<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>OMM Blog</h1>
    @each(post in posts)
    <h2>{{ post.title }}</h2>
    <i>{{ post.teaser }}</i>
    <p>{{ post.text}}
        <br>{{ post.author }}
    </p>
    @end
</body>
</html>