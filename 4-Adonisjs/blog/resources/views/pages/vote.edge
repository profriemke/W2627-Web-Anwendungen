<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <form action="/vote" method="post">
    {{ csrfField()}}
    <input type="radio" name="vote" value="spitze" id="spitze">
    <label for="spitze">Spitze!</label><br>
    <input type="radio" name="vote" value="geht" id="geht">
    <label for="geht">Geht so.</label><br>
    <input type="radio" name="vote" value="weg" id="weg">
    <label for="weg">Kann weg.</label><br>
    <input type="submit">
    </form>
</body>
</html>